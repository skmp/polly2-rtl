# --------------------------------------------------------------------------
# stage_all - isolated fileset for the whole-pipeline shade perf harness.
# (Formerly shade_pp.files.qip.) Paths are relative to this project dir
# (timming_tests/stage_all/), pointing up into ../../../polly2-core/rtl.
#
# STATUS: THIS PROJECT DOES NOT COMPILE YET. The paths below were repointed at
# the post-reorg tree and the cache-side files are correct, but stage_all.sv
# still instantiates `tsp_shade_pp` (and the old list wanted `tex_fetch_pp` and
# `rtl/isp_min/mac16.sv`) - all three are gone; the shade DUT is now
# tsp_shade_v2_pp with a different port list. Reviving stage_all needs the
# harness rewritten against tsp_shade_v2_pp, not just a file-list fix. Until
# then use stage_tex_fetch4 / stage_tex_unit, which do build.
# --------------------------------------------------------------------------

# ---- reduced-precision FP datapath (rtl/fp/, was rtl/isp_min/) ----
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/fp/fp_mul16.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/fp/fp_add24.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/fp/fp_add3_24.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/fp/fp_rcp_fast.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/fp/fp_mul_i5.sv"

# ---- HPS DDR3 bridge (vendored MiSTer files) ----
set_global_assignment -name SYSTEMVERILOG_FILE "../../../mister/f2sdram_safe_terminator.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../../mister/sysmem.sv"

# ---- tsp package (structs) MUST come first ----
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/gen/tsp_pkg.sv"

# ---- block-RAM primitives the cache is built from (must precede it) ----
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/buffers/bram_tdp.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/buffers/bram_sdp.sv"

# ---- texture fetch/decode/filter/addr + shade helpers ----
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/tsp/tex/tex_decode.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/tsp/tex/tex_addr.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/tsp/tex/tex_uvmap.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/tsp/tex/tex_filter.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/tsp/color_combiner.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/fp/f2u8.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/tsp/tex/tex_cache_4p_1c.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/tsp/tex/tsp_miplevel.sv"
set_global_assignment -name SYSTEMVERILOG_FILE "../../../polly2-core/rtl/buffers/delay_ram.sv"

# ---- DUT + harness ----
# MISSING: tsp_shade_pp.sv (replaced by rtl/tsp/tsp_shade_v2_pp.sv, different ports)
set_global_assignment -name SYSTEMVERILOG_FILE stage_all.sv

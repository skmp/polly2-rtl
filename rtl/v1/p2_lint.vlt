// p2_lint.vlt: verilator -Wall waivers for make lint (conventions.md 4.8). Every waiver is per file and names its
// reason; a unit's own lint target keeps its own file (tb/<unit>/<unit>_lint.vlt).
`verilator_config
// the shared packages declare items for every unit and for the testbenches: a build that does not use one of them
// is not wrong
lint_off -rule UNUSEDPARAM -file "*/p2_hw_pkg.sv"
lint_off -rule UNUSEDPARAM -file "*/p2_regs_pkg.sv"
lint_off -rule UNUSEDPARAM -file "*/p2_pkg.sv"
// p2_zword_pkg: signatures only until M1b (PLAN M0); its stub bodies do not read their arguments. Remove at M1b.
lint_off -rule UNUSEDSIGNAL -file "*/p2_zword_pkg.sv"
// p2_core: the M0 shell; no unit reads its inputs yet. Remove when the units are instanced (M12).
lint_off -rule UNUSEDSIGNAL -file "*/p2_core.sv"

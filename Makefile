# polly2-rtl: a bit-exact, cycle-accurate SystemVerilog model of the Dreamcast PowerVR2 CORE (README.md).
# Verilator simulation. This file holds only the shared tool and path variables; every unit's and every gate's targets
# live in its own fragment, tb/mk/<unit>.mk (conventions.md 6.1). Do not edit this file to add a unit.
#
#   make scaffold                    the M0 gate (tb/mk/scaffold.mk); last line "scaffold: PASS"
#   make lint                        verilator -Wall on p2_core and every unit top, LINT_J at a time (tb/mk/core.mk)
#   make hw-pkg-check, regs-pkg-check   the generated packages are up to date (tb/mk/gen.mk)
#   make hw-pkg, regs-pkg            regenerate them from nulldc3
#   make check-ref-copies, check-ref-switches, hw-pkg-selftest, tbcommon-selftest
#   make clean
#
# Paths (conventions.md 2), each overridable from the environment or the command line: the sibling checkouts
# nulldc3 (branch skmp/refsw3), dreamcast-tests and dreamster beside this one. Agents run make NJOBS=8.
#
# The job budget (PLAN 0 rule 8): P2_J, default nproc - 4 but at most the physical cores (tools/gate/jobs.sh); the
# gates' queues and parallel steps use it (tools/gate/lib.sh),
# make lint runs LINT_J (= P2_J) lint jobs at once.

CWD          := $(shell pwd)
NULLDC3      ?= $(abspath $(CWD)/../nulldc3)
REFCORE      ?= $(NULLDC3)/refsw3/refcore
REFTA        ?= $(NULLDC3)/refsw3/refta
DCTESTS      ?= $(abspath $(CWD)/../dreamcast-tests)
POLLY2_DUMPS ?= $(abspath $(CWD)/../dreamster/polly2-rtl/polly2-data/dumps)
# the RTL tree: every unit folder's default (ISP_DIR = $(RTLV1)/isp, ...) is under it, so that one copy of it can stand
# for all of them (M13: make frames-unit-mutants mutates any unit of p2_core through one control)
RTLV1        ?= rtl/v1
# the nulldc3 revision the testbenches print (tb/common/p2tb.h banner)
P2_REFREV    := $(shell git -C $(NULLDC3) rev-parse --short HEAD 2>/dev/null)
export NULLDC3 REFCORE REFTA DCTESTS POLLY2_DUMPS P2_REFREV

VERILATOR ?= verilator
NJOBS     ?= $(shell nproc 2>/dev/null || echo 4)
P2_J      ?= $(shell bash tools/gate/jobs.sh)
LINT_J    ?= $(P2_J)
export P2_J
BUILD      = build
# -Werror-USERFATAL: a failed elaboration check (rtl/v1/pkg/p2_hw_check.sv) stops every build
VFLAGS     = -Wno-DECLFILENAME -Wno-UNUSEDSIGNAL -Wno-UNUSEDPARAM -Werror-USERFATAL -j $(NJOBS) \
             --x-assign fast --x-initial fast
# simulation speed (shrike4 2026-09-26, agents/reports/verilator-perf.md): clang -O3 -march=native
P2_CC      = -MAKEFLAGS OPT_FAST=-O3 -MAKEFLAGS CXX=clang++ -MAKEFLAGS LINK=clang++ -CFLAGS "-O3 -march=native -std=c++17"

# refsw3-offline's compiler settings, parsed from its build.sh so that they cannot drift (conventions.md 7.3): the L2
# glue, p2-offline and anything else that compiles refcore's .cpp files or libswirl headers uses them
REFOFF_SH    = $(NULLDC3)/refsw3-offline/build.sh
REFOFF_FLAGS := $(shell sed -n 's/^FLAGS="\(.*\)"$$/\1/p' $(REFOFF_SH) 2>/dev/null)
REFOFF_INC   := $(subst $$N,$(NULLDC3),$(shell sed -n 's/^INC="\(.*\)"$$/\1/p' $(REFOFF_SH) 2>/dev/null))
REFOFF_DEF   := $(shell sed -n 's/^DEF="\(.*\)"$$/\1/p' $(REFOFF_SH) 2>/dev/null)

# host C++: generators and header-only testbench code on refcore (L1, conventions.md 7.3)
HOSTCXX       ?= g++
HOST_CXXFLAGS  = -std=c++17 -O2 -Wall -Wextra -I$(REFCORE) -I$(CWD)/tb/common

.DEFAULT_GOAL := help
.PHONY: help clean
help:
	@sed -n '1,/^$$/s/^# \{0,1\}//p' Makefile

# refglue.mk first: its variables (REFGLUE_OBJS, REFGLUE_REFDEPS, P2REF_CXXFLAGS, ...) appear in other fragments'
# prerequisite lists (isp_tile.mk), which make expands when it reads them; the rest in name order
-include tb/mk/refglue.mk
-include $(filter-out tb/mk/refglue.mk,$(sort $(wildcard tb/mk/*.mk)))

clean:
	rm -rf $(BUILD)
